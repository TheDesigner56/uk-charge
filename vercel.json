{
  "version": 2,
  "builds": [
    {
      "src": "ukcharge/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.12",
        "buildCommand": "bash build.sh",
        "includeFiles": "staticfiles/**,ukcharge/fixtures/**,db.sqlite3"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/ukcharge/wsgi.py"
    }
  ],
  "env": {
    "DJANGO_SETTINGS_MODULE": "ukcharge.settings",
    "VERCEL": "1"
  }
}