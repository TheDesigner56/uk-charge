# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (Neon Postgres for production, sqlite for local dev)
DATABASE_URL=postgres://user:pass@host/dbname?sslmode=require

# Open Charge Map API
OCM_API_KEY=your-ocm-api-key-here

# OCM API base URL
OCM_BASE_URL=https://api.openchargemap.io/v3

# Vercel
VERCEL=1
VERCEL_ENV=production
VERCEL_URL=uk-charge.vercel.app